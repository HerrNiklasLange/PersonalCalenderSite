# Copy to .env for local dev, and set the same values in
# Netlify -> Site configuration -> Environment variables for production.

# The password you type on the login screen.
PLANNER_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too
